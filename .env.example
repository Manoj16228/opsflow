# ==============================================================================
# OPSFLOW - Enterprise Operations Management & Analytics Platform
# Master Environment Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://opsflow_admin:opsflow_secure_password_2026@localhost:5432/opsflow_db?schema=public

# Analytical Database Connection (OLAP / Star Schema for ETL & Power BI)
ANALYTICS_DATABASE_URL=postgresql://opsflow_admin:opsflow_secure_password_2026@localhost:5432/opsflow_analytics?schema=public

# Redis & BullMQ Queues
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets
JWT_SECRET=opsflow_super_secret_jwt_access_token_key_2026_xyz987
JWT_REFRESH_SECRET=opsflow_super_secret_jwt_refresh_token_key_2026_abc123
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Configuration (local | azure)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=opsflow-attachments

# Email Notification Provider (smtp | mock | sendgrid)
EMAIL_PROVIDER=mock
EMAIL_FROM=notifications@opsflow.io
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=

# Logging & Monitoring
LOG_LEVEL=debug
APP_INSIGHTS_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
